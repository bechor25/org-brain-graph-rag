# Copy to .env — .env is gitignored.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=brainpass
NEO4J_DATABASE=neo4j
# docker image tag; fall back to neo4j:5.26 if the GDS plugin fails to load on this tag (see README)
NEO4J_IMAGE=neo4j:2026.06.0

OLLAMA_URL=http://localhost:11434
EMBED_MODEL=bge-m3
EMBED_DIM=1024

DATA_DIR=data

# Source registry (ADR-0005). Every org system lives in sources.yaml; only the tokens
# live here. Unset = anonymous, which is what the public ASF endpoints want.
SOURCES_FILE=sources.yaml
# JIRA_TOKEN=
# JIRA_USER=            # only for auth_scheme: basic (Atlassian Cloud: your email)
# CONFLUENCE_TOKEN=
# CONFLUENCE_USER=
# GIT_TOKEN=            # goes into the clone URL, never into a log
# ADO_PAT=              # Azure DevOps personal access token (HTTP basic, empty user)
# XRAY_TOKEN=
